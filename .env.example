# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Datenbank ---
DATABASE_URL=postgresql+asyncpg://vitalmapper:changeme@db:5432/vitalmapper

# --- Redis (Outbox-Consumer, Kapitel 11.3) ---
REDIS_URL=redis://redis:6379/0

# --- Ollama (Kapitel 14) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3

# --- Whisper-Service (eigener Container, Kapitel 10) ---
WHISPER_BASE_URL=http://whisper:8001
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
HF_HUB_DISABLE_XET=1
# Optional: Hugging Face read token for faster/rate-limited model downloads.
# Never commit the real token.
HF_TOKEN=

# --- Interoperabilitäts-Gateway (HAPI/Monitoring bleiben dahinter) ---
FHIR_BASE_URL=
FHIR_AUTH_TOKEN=
INTEROP_GATEWAY_URL=http://host.docker.internal:8600
INTEROP_TIMEOUT_SECONDS=10

# --- Security (F-26) ---
JWT_SECRET_KEY=changeme-use-a-real-secret-in-prod
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=15
LEGACY_AUTH_ENABLED=false

# --- Keycloak / OIDC BFF ---
KEYCLOAK_ISSUER=http://localhost:8081/realms/health-interop
KEYCLOAK_JWKS_URL=http://host.docker.internal:8081/realms/health-interop/protocol/openid-connect/certs
KEYCLOAK_API_AUDIENCE=monitoring-pflege-api
KEYCLOAK_CLIENT_ID=vital-mapper-frontend
KEYCLOAK_CLIENT_SECRET=replace-with-a-different-random-value
OIDC_AUTHORIZATION_URL=http://localhost:8081/realms/health-interop/protocol/openid-connect/auth
OIDC_TOKEN_URL=http://host.docker.internal:8081/realms/health-interop/protocol/openid-connect/token
OIDC_LOGOUT_URL=http://localhost:8081/realms/health-interop/protocol/openid-connect/logout
APP_ORIGIN=http://localhost:4000
BFF_REDIS_URL=redis://redis:6379/1
BFF_SESSION_ENCRYPTION_KEY=replace-with-a-valid-fernet-key
BFF_COOKIE_SECURE=false
# Nur fuer die kontrollierte Erstprovisionierung setzen, danach entfernen.
BOOTSTRAP_ADMIN_USERNAME=rucel
BOOTSTRAP_ADMIN_PASSWORD=rucel
# Fernet-Key erzeugen: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUDIO_ENCRYPTION_KEY=changeme-fernet-key-base64
AUDIO_STORAGE_PATH=/var/lib/vital-mapper/audio
MAX_AUDIO_BYTES=25000000

# --- Datenschutz (F-27) ---
AUDIO_RETENTION_DAYS=30
